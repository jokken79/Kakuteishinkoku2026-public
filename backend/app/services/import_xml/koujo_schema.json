{
  "version": "2026-06-21",
  "source": "https://www.e-tax.nta.go.jp/shiyo/download/kojoall.CAB",
  "source_page": "https://www.e-tax.nta.go.jp/shiyo/shiyo-kojo3.htm",
  "notes": "XSD oficiales extraídos de kojoall.CAB. Namespace compartido para todos los tipos: http://xml.e-tax.nta.go.jp/XSD/kyotsu. Todos los documentos llevan firma digital XML-DSIG (dsig:Signature requerida). Los campos de año 'gen:yyyy' son año occidental (西暦 4 dígitos). Los campos de año 'gen:yy' son era japonesa (元号): era 1=明治,2=大正,3=昭和,4=平成,5=令和 + yy 1-99. Los montos 'gen:kingaku' son enteros largos (xsd:long), sin decimales, en yenes.",
  "common_types": {
    "gen:kingaku": {
      "base_type": "xsd:long",
      "format": "integer",
      "unit": "JPY",
      "notes": "Entero largo, sin decimales. Patrón: [-]?\\d{1-15}. No incluye decimales (gaika/外貨 para moneda extranjera usa xsd:decimal separado)."
    },
    "gen:yyyy": {
      "base_type": "xsd:nonNegativeInteger",
      "format": "western_4digit",
      "notes": "Año en 西暦 (gregoriano). Elemento: <yyyy>2024</yyyy>. Min: 1, Max: 9999."
    },
    "gen:yy": {
      "base_type": "complex (era + yy)",
      "format": "wareki",
      "notes": "Año en era japonesa. Estructura: <era>5</era><yy>6</yy> = 令和6年 = 2024. era: 1=明治, 2=大正, 3=昭和, 4=平成, 5=令和."
    },
    "gen:yyyymmdd": {
      "base_type": "complex",
      "format": "western_date",
      "notes": "Fecha 西暦. Estructura: <yyyy/><mm/><dd/>."
    },
    "gen:yymmdd": {
      "base_type": "complex",
      "format": "wareki_date",
      "notes": "Fecha en era japonesa. Estructura: <era/><yy/><mm/><dd/>."
    },
    "gen:kubun": {
      "base_type": "complex",
      "format": "code+name",
      "notes": "Par código-nombre. <kubun_CD> entero 1 dígito, <kubun_NM> string opcional max 30 chars."
    }
  },
  "types": {
    "seimei_hoken": {
      "label": "生命保険料控除証明書",
      "xsd_file": "TEG800-001.xsd",
      "schema_version": "1.1",
      "schema_date": "2020-08-31",
      "root_element": "TEG800",
      "namespace": "http://xml.e-tax.nta.go.jp/XSD/kyotsu",
      "version_attribute": "VR",
      "version_values": ["1.0", "1.1"],
      "max_detail_rows": 100,
      "fields": {
        "insurance_company_name": {
          "xpath": "TEG800/WCA00000",
          "type": "gen:name",
          "required": true,
          "notes": "保険会社名. Tipo gen:name (string sin maxLength explícito en este campo)."
        },
        "corporate_number": {
          "xpath": "TEG800/WCB00000",
          "type": "gen:bango",
          "required": false,
          "notes": "法人番号. Estructura gen:bango: choice entre kojinbango (12 dígitos) o hojinbango (13 dígitos)."
        },
        "certificate_date": {
          "xpath": "TEG800/WCC00000",
          "type": "gen:yyyymmdd",
          "required": true,
          "notes": "証明日. Fecha en 西暦."
        },
        "contractor_name": {
          "xpath": "TEG800/WCD00000",
          "type": "string",
          "max_length": 100,
          "required": true,
          "notes": "契約者名."
        },
        "detail_rows": {
          "xpath": "TEG800/WCE00000",
          "type": "repeating",
          "max_occurrences": 100,
          "notes": "明細 繰り返し. Cada fila WCE00000 contiene los campos de detalle por póliza.",
          "children": {
            "certificate_year": {
              "xpath": "WCE00010",
              "type": "gen:yyyy",
              "format": "western_4digit",
              "required": true,
              "notes": "証明年. Año 西暦 4 dígitos."
            },
            "title": {
              "xpath": "WCE00020",
              "type": "string",
              "max_length": 35,
              "required": true,
              "notes": "題 (título/descripción de la póliza). Max 35 chars."
            },
            "applicable_system": {
              "xpath": "WCE00030",
              "type": "gen:kubun",
              "required": true,
              "values": {
                "1": "新制度",
                "2": "旧制度",
                "3": "両方"
              },
              "notes": "適用制度 (新/旧区分). kubun_CD: 1=新制度, 2=旧制度, 3=両方."
            },
            "policy_number": {
              "xpath": "WCE00040",
              "type": "string",
              "max_length": 30,
              "required": true,
              "notes": "証券番号."
            },
            "insurance_type": {
              "xpath": "WCE00050",
              "type": "string",
              "max_length": 30,
              "required": false,
              "notes": "保険種類 (e.g. 終身保険, 定期保険, 医療保険, etc.)."
            },
            "certified_amount_block": {
              "xpath": "WCE00190",
              "required": false,
              "notes": "証明額ブロック. Contiene subgrupos 旧制度 y 新制度, cada uno con subcategorías.",
              "children": {
                "old_system": {
                  "xpath": "WCE00220",
                  "required": false,
                  "notes": "旧制度ブロック.",
                  "children": {
                    "general_ippan_premium": {
                      "xpath": "WCE00220/WCE00230/WCE00240",
                      "type": "gen:kingaku",
                      "format": "integer",
                      "required": false,
                      "notes": "旧制度一般 保険料."
                    },
                    "general_ippan_dividend": {
                      "xpath": "WCE00220/WCE00230/WCE00250",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "旧制度一般 配当金."
                    },
                    "general_ippan_net": {
                      "xpath": "WCE00220/WCE00230/WCE00260",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "旧制度一般 差引保険料等合計額 (monto neto para declarar)."
                    },
                    "nenkin_premium": {
                      "xpath": "WCE00220/WCE00270/WCE00280",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "旧制度年金 保険料."
                    },
                    "nenkin_net": {
                      "xpath": "WCE00220/WCE00270/WCE00300",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "旧制度年金 差引保険料等合計額."
                    }
                  }
                },
                "new_system": {
                  "xpath": "WCE00310",
                  "required": false,
                  "notes": "新制度ブロック. Tres subcategorías: 一般, 介護医療, 年金.",
                  "children": {
                    "general_ippan_net": {
                      "xpath": "WCE00310/WCE00320/WCE00350",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "新制度一般 差引保険料等合計額."
                    },
                    "kaigo_iryo_net": {
                      "xpath": "WCE00310/WCE00360/WCE00390",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "新制度介護医療 差引保険料等合計額."
                    },
                    "nenkin_net": {
                      "xpath": "WCE00310/WCE00400/WCE00430",
                      "type": "gen:kingaku",
                      "required": false,
                      "notes": "新制度年金 差引保険料等合計額."
                    }
                  }
                }
              }
            },
            "estimated_december_amount": {
              "xpath": "WCE00440",
              "required": false,
              "notes": "証明額（12月期想定）ブロック. Mismo subárbol que WCE00190 pero son montos 参考 (申告額参考). Usar cuando el pago no cubre el año completo."
            }
          }
        }
      },
      "deduction_categories": {
        "notes": "Las categorías de deducción para 生命保険料控除 en 確定申告 son: 一般生命 (旧+新), 介護医療 (新のみ), 個人年金 (旧+新). El XSD no agrupa por deduction_category directamente — el parser debe inferirlo del applicable_system + nombre del bloque.",
        "old_system_categories": ["一般", "年金"],
        "new_system_categories": ["一般", "介護医療", "年金"]
      }
    },
    "jishin_hoken": {
      "label": "地震保険料控除証明書",
      "xsd_file": "TEG810-001.xsd",
      "schema_version": "1.1",
      "schema_date": "2022-08-30",
      "root_element": "TEG810",
      "namespace": "http://xml.e-tax.nta.go.jp/XSD/kyotsu",
      "version_attribute": "VR",
      "version_values": ["1.0", "1.1"],
      "max_detail_rows": 100,
      "fields": {
        "insurance_company_name": {
          "xpath": "TEG810/WDA00000",
          "type": "gen:name",
          "required": true,
          "notes": "保険会社名."
        },
        "corporate_number": {
          "xpath": "TEG810/WDB00000",
          "type": "gen:bango",
          "required": false,
          "notes": "法人番号."
        },
        "certificate_date": {
          "xpath": "TEG810/WDC00000",
          "type": "gen:yyyymmdd",
          "required": true,
          "notes": "証明日. Fecha 西暦."
        },
        "contractor_name": {
          "xpath": "TEG810/WDD00000",
          "type": "string",
          "max_length": 100,
          "required": true,
          "notes": "契約者名."
        },
        "detail_rows": {
          "xpath": "TEG810/WDE00000",
          "type": "repeating",
          "max_occurrences": 100,
          "notes": "明細 繰り返し por póliza.",
          "children": {
            "certificate_year": {
              "xpath": "WDE00010",
              "type": "gen:yyyy",
              "format": "western_4digit",
              "required": false,
              "notes": "証明年. Año 西暦."
            },
            "applicable_premium_type": {
              "xpath": "WDE00020",
              "type": "gen:kubun",
              "required": true,
              "values": {
                "1": "地震保険料",
                "2": "旧長期損害保険料（満期返戻金あり）",
                "3": "旧長期損害保険料（満期返戻金なし）"
              },
              "notes": "保険料控除の対象となる保険料の種類. kubun_CD 1-3."
            },
            "policy_number": {
              "xpath": "WDE00030/WDE00040",
              "type": "string",
              "max_length": 30,
              "required": true,
              "notes": "証券番号."
            },
            "insured_object": {
              "xpath": "WDE00070",
              "type": "gen:kubun",
              "required": true,
              "values": {
                "1": "建物",
                "2": "家財",
                "3": "建物及び家財",
                "4": "その他"
              },
              "notes": "保険の対象 (objeto asegurado)."
            },
            "earthquake_insurance_amount": {
              "xpath": "WDE00160/WDE00170",
              "type": "gen:kingaku",
              "format": "integer",
              "required": false,
              "notes": "地震保険料 (monto de prima de terremoto)."
            },
            "earthquake_deductible_amount": {
              "xpath": "WDE00160/WDE00180",
              "type": "gen:kingaku",
              "format": "integer",
              "required": false,
              "notes": "地震保険 控除対象保険料 (monto deducible de la prima de terremoto)."
            },
            "old_longterm_insurance_amount": {
              "xpath": "WDE00190/WDE00200",
              "type": "gen:kingaku",
              "format": "integer",
              "required": false,
              "notes": "旧長期損害保険料 (prima de seguro de daños a largo plazo antiguo)."
            },
            "old_longterm_deductible_amount": {
              "xpath": "WDE00190/WDE00210",
              "type": "gen:kingaku",
              "format": "integer",
              "required": false,
              "notes": "旧長期損害保険 控除対象保険料."
            }
          }
        }
      },
      "notes": "No tiene distinción 新/旧制度 en el mismo sentido que 生命保険. La distinción es 地震保険 vs 旧長期損害保険 (contratos anteriores a 2007). Cada uno tiene su propio límite de deducción."
    },
