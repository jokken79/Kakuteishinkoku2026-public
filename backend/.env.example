# Configuracion del backend de 確定申告 2026 — copiar a .env y ajustar.

# URL de conexion a PostgreSQL (SQLAlchemy + psycopg2).
# Puerto 5440 en host para no chocar con un postgres local en 5432.
DATABASE_URL=postgresql+psycopg2://kakutei:kakutei@localhost:5440/kakuteishinkoku

# Origenes permitidos para CORS (lista separada por comas, formato JSON tambien valido).
# CORS_ORIGINS=["http://localhost:5200"]

# Anio fiscal por defecto (令和7 = 2025).
FISCAL_YEAR_DEFAULT=2025

# --- PWA servida por el backend (un solo origen) -------------------------
# Carpeta del build del frontend. Vacio = autodetecta ../frontend/dist.
# FRONTEND_DIST=

# --- Login con Google (OPCIONAL, apagado por defecto) --------------------
# Con Tailscale no hace falta: la tailnet ya es privada. Prenderlo solo si el
# backend sale de la red privada. Pasos completos: docs/acceso-remoto.md
#
# AUTH_ALLOWED_EMAILS es el control que importa: entrar con Google no autoriza
# nada por si solo. Si AUTH_ENABLED=true y falta configuración, el servidor
# no arranca. Con AUTH_ENABLED=false la API queda sin autenticación.
# AUTH_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_EMAILS=["tu-cuenta@gmail.com"]
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET_KEY=
